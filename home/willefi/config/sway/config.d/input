### Input configuration Read `man 5 sway-input` for more information about this section. Touchpad configuration
input "type:touchpad" {
  dwt enabled
tap enabled
natural_scroll enabled
}

input "type:keyboard" {
    xkb_numlock disabled
    xkb_layout "fr"
    xkb_variant "us"
    xkb_options "caps:swapescape"
}
#
# # Assign the same binding to "pkill -RTMIN+1 waybar" to send signal to the Waybar keyboard module.
# # The signal refreshes the module. The commented example uses Alt + left Shift.
#
bindsym $mod++Shift+w exec "pkill -RTMIN+1 waybar"
